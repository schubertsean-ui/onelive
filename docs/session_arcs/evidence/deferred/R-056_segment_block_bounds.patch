+def _split_oversized(blocks: List[str]) -> List[str]:
+    """Split any block over MAX_BLOCK_CHARS on paragraph boundaries.
+
+    Nothing is discarded — an oversized block becomes several, and the
+    caller's accounted per-page cap decides how many to extract now and how
+    many to DEFER. Splitting is chosen over truncating precisely because
+    truncating is the data-loss class this module already had once.
+    """
+    out: List[str] = []
+    for block in blocks:
+        if len(block) <= MAX_BLOCK_CHARS:
+            out.append(block)
+            continue
+        pieces: List[str] = []
+        current = ""
+        for para in block.split("\n\n"):
+            candidate = f"{current}\n\n{para}" if current else para
+            if len(candidate) > MAX_BLOCK_CHARS and current:
+                pieces.append(current)
+                current = para
+            else:
+                current = candidate
+            # A single paragraph over the ceiling is hard-split rather than
+            # dropped: better a seam mid-paragraph than a lost event.
+            while len(current) > MAX_BLOCK_CHARS:
+                pieces.append(current[:MAX_BLOCK_CHARS])
+                current = current[MAX_BLOCK_CHARS:]
+        if current:
+            pieces.append(current)
+        kept = [p for p in pieces if len(p.strip()) >= _MIN_BLOCK_CHARS]
+        logger.warning(
+            "segment_events: a %d-char block exceeds MAX_BLOCK_CHARS=%d — "
+            "SPLIT into %d block(s), nothing dropped. An unsplit block this "
+            "size fails the provider outright ('prompt is too long') and "
+            "wastes one call per run.",
+            len(block), MAX_BLOCK_CHARS, len(kept),
+        )
+        out.extend(kept)
+    return out
+
+
 def _cap(blocks: List[str]) -> List[str]:
