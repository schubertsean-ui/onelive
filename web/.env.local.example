# Backend API base (FastAPI).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Clerk auth (stealth gate layer 1). Get real keys from the Clerk dashboard.
# The publishable key ships to the browser; the secret key is server-only and
# is used by middleware's server-side user lookup fallback (resolveEmail).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Stealth allowlist: comma-separated emails, matched case-insensitively.
# Read at request time in middleware.ts. UNSET OR EMPTY DENIES EVERYONE
# (fail-closed) — set it before expecting anyone (including yourself) to get in.
ONELIVE_ALLOWLIST=you@example.com,teammate@example.com
