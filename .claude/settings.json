{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/plan_first_banner.py",
            "timeout": 15,
            "statusMessage": "Loading 1Live plan-first rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/plan_first_gate.py",
            "timeout": 15,
            "statusMessage": "plan-first gate (§4a)"
          }
        ]
      }
    ]
  }
}
