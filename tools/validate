#!/usr/bin/env bash
# validate — the single end-of-shift "run everything" gate for OneLive.
# SUMMARY: runs every deterministic quality check in one pass, in order, and
# fails LOUD on any failure. Wires: trust_gate (trust invariants), lint
# (conventions), full pytest, eval_harness import check, perf benchmarks
# (`-m perf`), test_audit (false-confidence), commit_sweep (cross-commit
# gotchas), and visual_regression (SKIPPED-loud when the app isn't running —
# never a silent pass). Prints a PASS/FAIL/SKIP summary table; non-zero exit if
# anything FAILED. This is item 18 of the agentic-harness buildout and the
# mechanical "green before you finish / green before you sleep" step referenced
# by docs/OPERATING_RULES.md §2 and docs/skills/night_shift.md.
#
# Usage:
#   bash tools/validate            # run every check
#   bash tools/validate --strict   # also FAIL (not just advise) on commit_sweep
#                                   # and test_audit findings
#   bash tools/validate --quick    # skip the slow perf + commit_sweep checks
#   bash tools/validate --allow-skips
#                                   # human-acknowledged: exit 0 despite SKIP/
#                                   # ADVISORY rows (records the acknowledgement
#                                   # in the summary). Without this flag, ANY
#                                   # skipped or advisory-with-findings check
#                                   # makes the gate INCOMPLETE (exit 2).
#
# Exit codes (a SKIP or an unresolved ADVISORY is NOT a pass — §1 forbids
# "couldn't verify" looking identical to "passed"):
#             0 = every check RAN and PASSED (or skips were explicitly
#                 acknowledged with --allow-skips);
#             1 = at least one check FAILED;
#             2 = INCOMPLETE — a check was SKIPPED or an advisory check
#                 reported findings, and --allow-skips was not given.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

STRICT=0
QUICK=0
ALLOW_SKIPS=0
for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    --quick)  QUICK=1 ;;
    --allow-skips) ALLOW_SKIPS=1 ;;
    -h|--help)
      sed -n '2,31p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)
      echo "validate: unknown argument '$arg' (see --help)." >&2
      exit 1 ;;
  esac
done

PY="${PYTHON:-python3}"

# Results accumulate as "STATUS\tNAME\tNOTE" lines for the summary table.
RESULTS=()
ANY_FAIL=0
ANY_SKIP=0
ANY_ADVISORY=0

record() {
  RESULTS+=("$1"$'\t'"$2"$'\t'"${3:-}")
  case "$1" in
    SKIP)     ANY_SKIP=1 ;;
    ADVISORY) ANY_ADVISORY=1 ;;
  esac
}

run_check() {
  # run_check <name> <cmd...> — PASS on exit 0, else FAIL (loud).
  local name="$1"; shift
  echo "── ${name} ─────────────────────────────────────────────"
  if "$@"; then
    echo "[PASS] ${name}"
    record PASS "$name"
  else
    echo "[FAIL] ${name}" >&2
    record FAIL "$name"
    ANY_FAIL=1
  fi
  echo
}

run_advisory() {
  # run_advisory <name> <cmd...> — advisory (findings don't fail) unless
  # --strict, in which case exit!=0 becomes a FAIL. Always runs; never silent.
  local name="$1"; shift
  echo "── ${name}$( [ "$STRICT" -eq 1 ] && echo ' (strict)' ) ──────────────"
  if "$@"; then
    echo "[PASS] ${name}"
    record PASS "$name"
  else
    if [ "$STRICT" -eq 1 ]; then
      echo "[FAIL] ${name} (findings, --strict)" >&2
      record FAIL "$name" "findings (strict)"
      ANY_FAIL=1
    else
      echo "[ADVISORY] ${name} reported findings — review them (non-blocking)."
      record ADVISORY "$name" "findings — review"
    fi
  fi
  echo
}

echo "================================================================"
echo " OneLive · tools/validate · $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo " strict=${STRICT} quick=${QUICK}"
echo "================================================================"
echo

# 1. Trust invariants — deterministic, must pass.
run_check "trust_gate" "$PY" tools/trust_gate.py

# 2. Conventions linter — must pass (no --fix here; validate must not mutate).
run_check "lint" "$PY" tools/lint.py

# 2b. Recording enforcement — no silent deferrals: deferral-language code
#     comments must carry a live [R-###] tag from docs/RECORD.md (founder
#     rule 2026-07-13; see CLAUDE.md "The Record").
run_check "deferral_scan" "$PY" tools/deferral_scan.py

# 3. Full test suite — must pass. DB-integration tests self-skip without a DSN;
#    that self-skip is internal to pytest and reported in its own output.
run_check "pytest (full suite)" "$PY" -m pytest -q

# 4. Extraction eval harness import check — must at least import cleanly (no
#    import-time regressions in the KPI-bearing module).
run_check "eval_harness import" "$PY" -c \
  "import ai.eval_harness as e; print('eval_harness import OK:', [n for n in dir(e) if not n.startswith('_')][:6])"

# 5. Performance benchmarks — asserted budgets on hot paths. Opt-in marker.
if [ "$QUICK" -eq 1 ]; then
  echo "── perf benchmarks ──"
  echo "[SKIP-loud] perf benchmarks skipped by --quick. NOT a pass — rerun without --quick before end-of-shift." >&2
  record SKIP "perf benchmarks" "--quick (rerun before close)"
  echo
else
  run_check "perf benchmarks" "$PY" -m pytest -q -m perf
fi

# 6. False-confidence test audit — advisory (surfaces weak tests).
run_advisory "test_audit" "$PY" tools/test_audit.py

# 7. Cross-commit sweep — advisory (higher-level gotchas across commits).
if [ "$QUICK" -eq 1 ]; then
  echo "── commit_sweep ──"
  echo "[SKIP-loud] commit_sweep skipped by --quick. NOT a pass." >&2
  record SKIP "commit_sweep" "--quick (rerun before close)"
  echo
else
  run_advisory "commit_sweep" "$PY" tools/commit_sweep.py
fi

# 8. Visual regression — needs a booted app + baselines; cannot run headless
#    here. Detect and SKIP-LOUD (never a silent pass), per the item-15 harness.
echo "── visual_regression ──"
VR_NOTE="app not running / baselines absent"
if [ -n "${ONELIVE_APP_URL:-}" ]; then
  if run_check_vr=$("$PY" tools/visual_regression.py --help >/dev/null 2>&1; echo $?); then :; fi
  echo "[INFO] ONELIVE_APP_URL set (${ONELIVE_APP_URL}). Run visual_regression.py capture-and-compare manually per docs/../tests/visual_baselines/README.md." 
  echo "[SKIP-loud] validate does not auto-boot the app; visual regression must be run against a live URL with committed baselines." >&2
  record SKIP "visual_regression" "run manually vs live URL"
else
  echo "[SKIP-loud] visual_regression: ONELIVE_APP_URL not set and no booted app — SKIPPED, NOT passed." >&2
  echo "            To run: start the web app, set ONELIVE_APP_URL, then (name is positional," >&2
  echo "            --capture-cmd is required and needs {url}/{out} placeholders):" >&2
  echo "            python tools/visual_regression.py capture-and-compare ops_inbox \\" >&2
  echo "                --url \$ONELIVE_APP_URL/ops \\" >&2
  echo "                --capture-cmd 'playwright screenshot {url} {out} --viewport-size=1280,800'" >&2
  record SKIP "visual_regression" "$VR_NOTE"
fi
echo

# ---- Summary table -----------------------------------------------------------
echo "================================================================"
echo " VALIDATE SUMMARY"
echo "================================================================"
printf '  %-8s %-22s %s\n' "STATUS" "CHECK" "NOTE"
printf '  %-8s %-22s %s\n' "------" "-----" "----"
for row in "${RESULTS[@]}"; do
  IFS=$'\t' read -r status name note <<< "$row"
  printf '  %-8s %-22s %s\n' "$status" "$name" "$note"
done
echo "----------------------------------------------------------------"

if [ "$ANY_FAIL" -ne 0 ]; then
  echo "RESULT: FAIL — at least one check failed. Do not finish/sleep on red." >&2
  exit 1
fi

# A SKIP (something couldn't be verified) or an ADVISORY-with-findings (a weak
# test / cross-commit gotcha surfaced) is NOT a pass. §1 forbids "couldn't
# verify" or "found something" looking identical to "passed". The gate is
# INCOMPLETE (exit 2) unless a human explicitly acknowledges with --allow-skips.
if [ "$ANY_SKIP" -ne 0 ] || [ "$ANY_ADVISORY" -ne 0 ]; then
  reasons=""
  [ "$ANY_SKIP" -ne 0 ]     && reasons="skipped checks"
  [ "$ANY_ADVISORY" -ne 0 ] && reasons="${reasons:+$reasons + }advisory findings"
  if [ "$ALLOW_SKIPS" -eq 1 ]; then
    echo "RESULT: PASS (--allow-skips) — ${reasons} present but explicitly acknowledged."
    echo "        This is a human-acknowledged incomplete run, NOT a fully verified one."
    echo "        Resolve them (esp. visual_regression) before the shift is truly closed."
    exit 0
  fi
  echo "RESULT: INCOMPLETE — ${reasons}. This is NOT a pass." >&2
  echo "        Resolve the SKIP/ADVISORY rows above, or re-run with --allow-skips" >&2
  echo "        to record a human-acknowledged incomplete run (exit 0)." >&2
  exit 2
fi

echo "RESULT: PASS — every check ran and passed. Safe to finish."
exit 0
