#!/usr/bin/env bash
# validate — the single end-of-shift "run everything" gate for OneLive.
# SUMMARY: runs every deterministic quality check in one pass, in order, and
# fails LOUD on any failure. Wires: trust_gate (trust invariants), lint
# (conventions), full pytest, eval_harness import check, perf benchmarks
# (`-m perf`), test_audit (false-confidence), commit_sweep (cross-commit
# gotchas), and visual_regression (SKIPPED-loud when the app isn't running —
# never a silent pass). Prints a PASS/FAIL/SKIP summary table; non-zero exit if
# anything FAILED. This is item 18 of the agentic-harness buildout and the
# mechanical "green before you finish / green before you sleep" step referenced
# by docs/OPERATING_RULES.md §2 and docs/skills/night_shift.md.
#
# Usage:
#   bash tools/validate            # run every check
#   bash tools/validate --strict   # also FAIL (not just advise) on commit_sweep
#                                   # and test_audit findings
#   bash tools/validate --quick    # skip the slow perf + commit_sweep checks
#   bash tools/validate --allow-skips
#                                   # human-acknowledged: exit 0 despite SKIP/
#                                   # ADVISORY rows (records the acknowledgement
#                                   # in the summary). Without this flag, ANY
#                                   # skipped or advisory-with-findings check
#                                   # makes the gate INCOMPLETE (exit 2).
#
# Exit codes (a SKIP or an unresolved ADVISORY is NOT a pass — §1 forbids
# "couldn't verify" looking identical to "passed"):
#             0 = every check RAN and PASSED (or skips were explicitly
#                 acknowledged with --allow-skips);
#             1 = at least one check FAILED;
#             2 = INCOMPLETE — a check was SKIPPED or an advisory check
#                 reported findings, and --allow-skips was not given.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

STRICT=0
QUICK=0
ALLOW_SKIPS=0
for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    --quick)  QUICK=1 ;;
    --allow-skips) ALLOW_SKIPS=1 ;;
    -h|--help)
      sed -n '2,31p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)
      echo "validate: unknown argument '$arg' (see --help)." >&2
      exit 1 ;;
  esac
done

PY="${PYTHON:-python3}"

# Results accumulate as "STATUS\tNAME\tNOTE" lines for the summary table.
RESULTS=()
ANY_FAIL=0
ANY_SKIP=0
ANY_ADVISORY=0

record() {
  # Statuses: PASS/FAIL/ADVISORY/SKIP, plus QSKIP — a STRUCTURED quick-mode
  # skip recorded ONLY at the two --quick sites below. QSKIP is exempt from
  # Record binding by status (never by note text — evaluator r3, PR #35) but
  # still counts as a skip for the exit-code discipline.
  RESULTS+=("$1"$'\t'"$2"$'\t'"${3:-}")
  case "$1" in
    SKIP|QSKIP) ANY_SKIP=1 ;;
    ADVISORY)   ANY_ADVISORY=1 ;;
  esac
}

run_check() {
  # run_check <name> <cmd...> — PASS on exit 0, else FAIL (loud).
  local name="$1"; shift
  echo "── ${name} ─────────────────────────────────────────────"
  if "$@"; then
    echo "[PASS] ${name}"
    record PASS "$name"
  else
    echo "[FAIL] ${name}" >&2
    record FAIL "$name"
    ANY_FAIL=1
  fi
  echo
}

run_advisory() {
  # run_advisory <name> <cmd...> — advisory (findings don't fail) unless
  # --strict, in which case findings become a FAIL. Always runs; never
  # silent. Exit contract (evaluator r13): 0 = clean → PASS; 3 = findings,
  # advisory → ADVISORY row (never plain PASS — evidence must distinguish
  # clean from findings-present); anything else = the tool itself broke →
  # FAIL regardless of strictness.
  local name="$1"; shift
  echo "── ${name}$( [ "$STRICT" -eq 1 ] && echo ' (strict)' ) ──────────────"
  "$@"
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "[PASS] ${name}"
    record PASS "$name"
  elif [ "$rc" -eq 3 ] && [ "$STRICT" -eq 0 ]; then
    echo "[ADVISORY] ${name} reported findings — review them (non-blocking)."
    record ADVISORY "$name" "findings — review"
  elif [ "$rc" -eq 3 ]; then
    echo "[FAIL] ${name} (findings, --strict)" >&2
    record FAIL "$name" "findings (strict)"
    ANY_FAIL=1
  else
    echo "[FAIL] ${name} — the tool itself failed (rc=${rc}), not a findings exit" >&2
    record FAIL "$name" "tool failed (rc=${rc})"
    ANY_FAIL=1
  fi
  echo
}

echo "================================================================"
echo " OneLive · tools/validate · $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo " strict=${STRICT} quick=${QUICK}"
echo "================================================================"
echo

# 1. Trust invariants — deterministic, must pass.
run_check "trust_gate" "$PY" tools/trust_gate.py

# 2. Conventions linter — must pass (no --fix here; validate must not mutate).
run_check "lint" "$PY" tools/lint.py

# 2b. Recording enforcement — no silent deferrals: deferral-language code
#     comments must carry a live [R-###] tag from docs/RECORD.md (founder
#     rule 2026-07-13; see CLAUDE.md "The Record").
run_check "deferral_scan" "$PY" tools/deferral_scan.py

# 2c. Env-contract linter for GitHub workflows (R-019, the empty-env class
#     fix): every env var a run step consumes has a visible reviewed source,
#     and the vars. context (unset==empty, can't fail closed) is banned.
run_check "workflow_env_lint" "$PY" tools/workflow_env_lint.py
run_check "governance_claims" "$PY" tools/governance_claims_lint.py

# 3. Full test suite — must pass. DB-integration tests self-skip without a DSN;
#    that self-skip is internal to pytest and reported in its own output.
run_check "pytest (full suite)" "$PY" -m pytest -q

# 3b. Blocking-effect classifier (founder-directed 2026-07-25, after a
#     merge-blocking failure was reported for hours as "pre-existing" and
#     "operational" — language that read as cosmetic). Both required gates
#     (trust-gate.yml, adversarial-review.yml) run an UNFILTERED full-suite
#     pytest, so ANY failing test reds BOTH and blocks the merge. This check
#     names the blocked gates explicitly and refuses the two invalid
#     downgrades ("pre-existing", "recorded as R-###") — so the class is
#     caught mechanically, not by remembering to be careful. Runs AFTER the
#     suite so a green suite makes it a no-op.
run_check "blocking_failure_check" "$PY" tools/blocking_failure_check.py

# 4. Extraction eval harness import check — must at least import cleanly (no
#    import-time regressions in the KPI-bearing module).
run_check "eval_harness import" "$PY" -c \
  "import ai.eval_harness as e; print('eval_harness import OK:', [n for n in dir(e) if not n.startswith('_')][:6])"

# 4b. Surface extraction regression-exam — deterministic, free (no network/
#     model/spend) no-regression guard on the un-certified extraction SURFACE
#     (worker/segment.py + worker/ai_extract fan-out): runs a labeled corpus of
#     multi-event pages through the REAL pipeline with a recorded provider and
#     FAILS if event recall drops below any page's measured baseline or any
#     fabrication appears. NOT a certification — the attended golden-exam remains
#     the authority for the certified prompt/model (see docs/RECORD.md R-035).
#     Gate-custody: evaluator-reviewed on the PR that adds it.
run_check "surface_regression_exam" "$PY" tools/surface_regression_exam.py

# 4c. Brain memory eval — deterministic, free (no network/model/spend) MEASURE of
#     the persistent knowledge-graph brain (brain/) against a labeled benchmark of
#     the six standard agent-memory competencies (single-fact, multi-hop, knowledge
#     update, contradiction, entity resolution, abstention). Per-category baselines
#     (brain/eval/baselines.json) are a ONE-WAY RATCHET, like surface_regression_exam:
#     FAILS if any category's accuracy drops below its recorded baseline. Proves the
#     brain is best-in-class as a MEASURED fact, not a claim; the honest temporal gap
#     (point-in-time recall, docs/RECORD.md R-010/R-031) is recorded in the baseline.
#     Gate-custody: evaluator-reviewed on the PR that adds it.
run_check "brain_eval" "$PY" tools/brain_eval.py

# 4c-bis. Brain HELD-OUT eval — NOTE, deliberately NOT a normal in-repo gate.
#     tools/brain_held_out_eval.py scores a HIDDEN, held-out counterpart to the
#     visible brain benchmark (brain/eval/held_out*). Its trust value comes from
#     BASE-OWNERSHIP, not from running here: the AUTHORITY is the base-owned
#     workflow .github/workflows/brain-held-out-eval.yml (pull_request_target),
#     which scores the PR head's brain with the BASE ref's copy of the hidden
#     set + scorer, so a PR cannot see-and-alter the copy that grades it. Adding
#     it as a normal `run_check` here would run the PR's OWN copy of the hidden
#     set/scorer against itself — the exact self-grading the base-owned design
#     exists to prevent — so it is intentionally omitted. Run it as a DEV MIRROR
#     with `python tools/brain_held_out_eval.py` (non-authoritative); the real
#     judge is the CI workflow. See docs/strategy/ONE_LIVE_HELDOUT_EVAL_v1.md
#     and docs/RECORD.md R-045.

# 4d. Brain IQ ratchet — deterministic, free (no network/model/spend) one-way
#     GUARD on the brain's multi-dimensional smartness (brain/iq.py): the two
#     GATED dimensions (KNOWLEDGE accuracy and EFFICIENCY graph-work per query)
#     must each stay >= their best recorded value in the continuous trend ledger
#     (docs/metrics/BRAIN_IQ_LEDGER.md) minus a tiny epsilon — knowledge dropping
#     or work rising turns this RED. Same ratchet shape as brain_eval /
#     surface_regression_exam: when the brain improves, re-measure and RAISE the
#     recorded best (append a ledger row) in the same PR; the gate only ratchets
#     up. LEARNING is trended but NOT gated, and wall latency is recorded but
#     NEVER gated (machine-dependent). Gate-custody: evaluator-reviewed on the
#     PR that adds it.
run_check "brain_iq" "$PY" tools/brain_iq.py --check

# 5. Performance benchmarks — asserted budgets on hot paths. Opt-in marker.
if [ "$QUICK" -eq 1 ]; then
  echo "── perf benchmarks ──"
  echo "[SKIP-loud] perf benchmarks skipped by --quick. NOT a pass — rerun without --quick before end-of-shift." >&2
  record QSKIP "perf benchmarks" "--quick (rerun before close)"
  echo
else
  run_check "perf benchmarks" "$PY" -m pytest -q -m perf
fi

# 6. False-confidence test audit — advisory (surfaces weak tests).
run_advisory "test_audit" "$PY" tools/test_audit.py

# PR-size early warning (founder-directed 2026-07-25). PR #59 grew to 1.26 MB
# against the adversarial reviewer's 800 KB cap, so the MANDATORY independent
# review refused to run at all — and splitting 45 commits after the fact is
# high-risk churn. This measures the branch diff the same way the review
# workflow does and says "split now, while it is cheap" at 70% of the cap.
# ADVISORY on purpose: a legitimately large change must not be blocked from
# running its other gates — the point is to see the wall coming, not to bump
# into it.
run_advisory "pr_size_check" "$PY" tools/pr_size_check.py

# 7. Cross-commit sweep — advisory (higher-level gotchas across commits).
if [ "$QUICK" -eq 1 ]; then
  echo "── commit_sweep ──"
  echo "[SKIP-loud] commit_sweep skipped by --quick. NOT a pass." >&2
  record QSKIP "commit_sweep" "--quick (rerun before close)"
  echo
else
  run_advisory "commit_sweep" "$PY" tools/commit_sweep.py
  # M9 reviewer scorecard (Contract #26): ADVISORY measure of the adversarial
  # reviewer itself, derived mechanically from the Kaizen ledger (round-1
  # recall, sibling-misses, novelty). Instrumentation, not a gate — it feeds
  # the weekly digest and lens-pruning; any threshold it enforces later is a
  # gate change (evaluator-mandatory).
  run_advisory "reviewer_scorecard" "$PY" tools/reviewer_scorecard.py
fi

# 7b. Kaizen trend meter — computes the trend report from the ledger
#     (docs/KAIZEN.md "Trend instrumentation"). HARD GATE (evaluator r5: an
#     M3 escape or an unaddressed repeat-class alarm must never be waivable
#     by --allow-skips — an alarm is a due fix, not information): findings
#     turn the run RED outright.
run_check "kaizen_trends" "$PY" tools/kaizen_trends.py

# 7c. Construction Loop Stage 3 gate (charter Thinking-tools item 4, #67 r4:
#     the blocking-retrieval rule ships WITH its mechanism; r5: citations
#     bind to the CURRENT CHANGE'S ADDED LINES, never cumulative STATE
#     history) — matches the diff's changed paths against
#     docs/memory/RED_CLASSES.md and requires this change to write its own
#     citations. HARD GATE, same physics as kaizen_trends. A missing base
#     ref is gate MISCONFIGURATION and FAILS CLOSED (#67 r5: never a
#     silent no-op in shallow/local clones).
# Base freshness lives INSIDE the gate now (#71 r5-r8), not in this
# wrapper. A shell `git fetch` here proved only that THIS process could
# fetch, which is not the property. The gate compares the base ref's id
# against the remote's current tip and fails closed on anything else —
# there is deliberately NO offline path (every local substitute is
# reproducible from a stale base), so the gate needs remote access and
# the CI review job grants it read-only for the validate step alone.
# Same fail-closed physics, one mechanism, unit-tested.
run_check "construction_gate" "$PY" tools/construction_gate.py

# Change-set discipline (docs/skills/change_set_discipline.md), founder-directed
# 2026-07-26 after the same review spiral happened twice — #68 at 22 rounds and
# #74 at 11. Both times the lesson was written as PROSE and nothing executed it,
# which the Construction Loop already calls an open defect. Review effectiveness
# has a measured ceiling (~400 lines, Google/SmartBear); past it a change is
# skimmed, not reviewed, and a change that GROWS under review can never
# converge because each round judges a bigger subject than the last.
run_check "change_set_gate" "$PY" tools/change_set_gate.py

# 8. Visual regression — needs a booted app + baselines; cannot run headless
#    here. Detect and SKIP-LOUD (never a silent pass), per the item-15 harness.
echo "── visual_regression ──"
VR_NOTE="app not running / baselines absent"
# Surface the Record binding at FIRST emission (evaluator r3 nit) — computed,
# never hardcoded, so this message can't drift from the register.
VR_RID="$("$PY" tools/skip_record_binding.py visual_regression 2>/dev/null || echo 'NO OPEN RECORD ROW — this skip will FAIL below')"
if [ -n "${ONELIVE_APP_URL:-}" ]; then
  echo "[INFO] ONELIVE_APP_URL set (${ONELIVE_APP_URL}). Run visual_regression.py capture-and-compare manually per docs/../tests/visual_baselines/README.md."
  echo "[SKIP-loud] validate does not auto-boot the app; visual regression must be run against a live URL with committed baselines. (Record: ${VR_RID})" >&2
  record SKIP "visual_regression" "run manually vs live URL"
else
  echo "[SKIP-loud] visual_regression: ONELIVE_APP_URL not set and no booted app — SKIPPED, NOT passed. (Record: ${VR_RID})" >&2
  echo "            To run: start the web app, set ONELIVE_APP_URL, then (name is positional," >&2
  echo "            --capture-cmd is required and needs {url}/{out} placeholders):" >&2
  echo "            python tools/visual_regression.py capture-and-compare ops_inbox \\" >&2
  echo "                --url \$ONELIVE_APP_URL/ops \\" >&2
  echo "                --capture-cmd 'playwright screenshot {url} {out} --viewport-size=1280,800'" >&2
  record SKIP "visual_regression" "$VR_NOTE"
fi
echo

# ---- Skip→Record binding (mechanical, added 2026-07-18) ----------------------
# Class fixes: skip-report-missing-record-citation (founder-caught) and the
# unverifiable-claim family (evaluator-caught on PRs #20/#27/#35). Every
# ENVIRONMENTAL skip must correspond to an OPEN docs/RECORD.md row that names
# the check as a backticked token (deviation + cited bar + objective trigger)
# or it becomes a FAILURE — --allow-skips never covers an unrecorded skip.
# Quick-mode skips are exempt via the STRUCTURED QSKIP status set only at the
# two --quick sites above (never via note text — evaluator r3); they still
# block a clean close without --allow-skips. This section only ADDS failure
# modes; nothing that failed before can pass now.
# The loop lives in a sourced, directly-tested file (evaluator r3: the
# exemption must be structured state, and the loop itself must be testable).
source "$REPO_ROOT/tools/validate_bind_skips.sh"
bind_skips
RESULTS=("${BOUND_RESULTS[@]}")

# ---- Machine-stamped evidence block ------------------------------------------
# Evidence is GENERATED, never hand-copied (the unverifiable-claim class fix):
# printed to stdout and written to .validate-evidence.txt (gitignored) for
# verbatim paste into session arcs / PR bodies. In CI this whole run is teed
# to a log the evaluator receives, so the block also arrives as a command
# artifact that can actually fail.
emit_evidence() {
  local result="$1"
  local out=".validate-evidence.txt"
  {
    echo "---- VALIDATE EVIDENCE (machine-generated by tools/validate; paste verbatim) ----"
    echo "generated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "git_head: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
    echo "git_branch: $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    echo "worktree: $(git status --porcelain 2>/dev/null | grep -q . && echo dirty || echo clean)"
    echo "flags: strict=${STRICT} quick=${QUICK} allow_skips=${ALLOW_SKIPS}"
    local row status name note
    for row in "${RESULTS[@]}"; do
      IFS=$'\t' read -r status name note <<< "$row"
      echo "check: ${name} = ${status}${note:+ (${note})}"
    done
    echo "result: ${result}"
    echo "--------------------------------------------------------------------------------"
  } | tee "$out"
  echo "(evidence also written to ${out} — gitignored; paste it verbatim, never retype)"
}

# ---- Summary table -----------------------------------------------------------
echo "================================================================"
echo " VALIDATE SUMMARY"
echo "================================================================"
printf '  %-8s %-22s %s\n' "STATUS" "CHECK" "NOTE"
printf '  %-8s %-22s %s\n' "------" "-----" "----"
for row in "${RESULTS[@]}"; do
  IFS=$'\t' read -r status name note <<< "$row"
  printf '  %-8s %-22s %s\n' "$status" "$name" "$note"
done
echo "----------------------------------------------------------------"

if [ "$ANY_FAIL" -ne 0 ]; then
  emit_evidence "FAIL"
  echo "RESULT: FAIL — at least one check failed. Do not finish/sleep on red." >&2
  exit 1
fi

# A SKIP (something couldn't be verified) or an ADVISORY-with-findings (a weak
# test / cross-commit gotcha surfaced) is NOT a pass. §1 forbids "couldn't
# verify" or "found something" looking identical to "passed". The gate is
# INCOMPLETE (exit 2) unless a human explicitly acknowledges with --allow-skips.
if [ "$ANY_SKIP" -ne 0 ] || [ "$ANY_ADVISORY" -ne 0 ]; then
  reasons=""
  [ "$ANY_SKIP" -ne 0 ]     && reasons="skipped checks"
  [ "$ANY_ADVISORY" -ne 0 ] && reasons="${reasons:+$reasons + }advisory findings"
  if [ "$ALLOW_SKIPS" -eq 1 ]; then
    # Message stays truthful in quick mode (evaluator r4 nit): only
    # environmental skips are Record-bound; quick-mode skips are
    # flag-inflicted and must be rerun before close.
    if [ "$QUICK" -eq 1 ]; then
      emit_evidence "INCOMPLETE-ACKNOWLEDGED (--allow-skips; environmental SKIPs Record-bound; --quick skips are flag-inflicted — rerun before close)"
      echo "RESULT: INCOMPLETE-ACKNOWLEDGED (exit 0 because --allow-skips) — ${reasons} present, explicitly acknowledged."
      echo "        Quick-mode skips are flag-inflicted — rerun without --quick before close."
      exit 0
    fi
    # Precision (PR #46 r2/r5/r6): when NOT in quick mode, every surviving
    # SKIP has already passed the skip->Record binding (an unrecorded skip
    # is a hard FAIL above) — Record-bound debt, enumerated in rows above.
    # ADVISORY gates are DIFFERENT (r6): they RAN and surfaced non-blocking
    # findings — they are neither passes nor Record-bound, and the terminal
    # state must never describe them as either. Exit semantics unchanged in
    # both branches; release evidence still requires skipped gates to run.
    if [ "$ANY_ADVISORY" -eq 0 ]; then
      emit_evidence "EXECUTED-GATES-GREEN (--allow-skips; every executed gate PASSED; every SKIP is bound to an OPEN Record row above — release evidence still requires those gates to run)"
      echo "RESULT: EXECUTED-GATES-GREEN (exit 0 via --allow-skips) — every executed gate PASSED; every SKIP is Record-bound (rows above)."
      echo "        Release evidence still requires the skipped gates to run (see their Record rows)."
    else
      emit_evidence "EXECUTED-GATES-ACKNOWLEDGED (--allow-skips; no gate FAILED; ADVISORY findings present — those gates ran and surfaced non-blocking findings, which are NOT passes and NOT Record-bound (rows above); any SKIP is bound to an OPEN Record row — release evidence still requires skipped gates to run)"
      echo "RESULT: EXECUTED-GATES-ACKNOWLEDGED (exit 0 via --allow-skips) — no gate FAILED."
      echo "        ADVISORY findings present (rows above): those gates ran and surfaced non-blocking findings — not passes, not Record-bound; review them."
      [ "$ANY_SKIP" -ne 0 ] && echo "        Every SKIP is Record-bound (rows above); release evidence still requires those gates to run."
    fi
    exit 0
  fi
  emit_evidence "INCOMPLETE"
  echo "RESULT: INCOMPLETE — ${reasons}. This is NOT a pass." >&2
  echo "        Resolve the SKIP/ADVISORY rows above, or re-run with --allow-skips" >&2
  echo "        to record a human-acknowledged incomplete run (exit 0)." >&2
  exit 2
fi

emit_evidence "PASS"
echo "RESULT: PASS — every check ran and passed. Safe to finish."
exit 0
